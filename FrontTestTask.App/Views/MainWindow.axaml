<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrontTestTask.Common.ViewModels;assembly=FrontTestTask.Common"
        xmlns:views="using:FrontTestTask.App.Views"
        xmlns:vmi="clr-namespace:FrontTestTask.Common.ViewModels.Interfaces;assembly=FrontTestTask.Common"
        x:Class="FrontTestTask.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1000" Height="640"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,300" Margin="16">

        <ItemsControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                      Margin="0,0,0,12"
                      ItemsSource="{Binding Sections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmi:ISectionViewModel">
                    <Button Classes="nav"
                            Classes.selected="{Binding IsSelected}"
                            Content="{Binding Title}"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).NavigateCommand}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0,0,12,0">
            <ContentControl Content="{Binding CurrentSection}" />
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Classes="card">
            <views:AuthView DataContext="{Binding Auth}" />
        </Border>
    </Grid>
</Window>
