<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FrontTestTask.Common.ViewModels"
        x:Class="FrontTestTask.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Title}"
        Width="1000" Height="640"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,300" Margin="16">

        <!-- Меню разделов -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Spacing="8" Margin="0,0,0,12" />

        <!-- Активный раздел -->
        <Border Grid.Row="1" Grid.Column="0" Classes="card" Margin="0,0,12,0" />

        <!-- Панель авторизации -->
        <Border Grid.Row="1" Grid.Column="1" Classes="card" />
    </Grid>
</Window>
